NODE_ENV=development
PORT=8080
HOST=127.0.0.1
APP_NAME=ULTRON
ULTRON_SETUP_KEY=replace-with-a-long-random-one-time-setup-key
ULTRON_SESSION_SECRET=replace-with-a-long-random-secret
ULTRON_TOKEN_ENCRYPTION_KEY=
TRUST_PROXY=false

# Optional AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-astra

# Persistent database
DATABASE_URL=
PGSSLMODE=

# Google OAuth — active read-only connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-ULTRON-HOST/api/integrations/google/callback

# Planned integrations — not active until their connectors are implemented
YOUTUBE_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
