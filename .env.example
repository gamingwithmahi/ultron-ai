NODE_ENV=development
PORT=8080
HOST=127.0.0.1
APP_NAME=ULTRON
# Required once to create the first administrator. Use a long random value.
ULTRON_SETUP_KEY=replace-with-a-long-random-one-time-setup-key
# Required in production to sign administrator sessions.
ULTRON_SESSION_SECRET=replace-with-a-long-random-secret
# Set true only behind a trusted reverse proxy.
TRUST_PROXY=false
\n# Optional: enables the ULTRON chat assistant. Keep this key server-side only.\nOPENAI_API_KEY=\nOPENAI_MODEL=gpt-6.2-astra\n
# Google OAuth read-only integration (keep all credentials secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-ULTRON-HOST/api/integrations/google/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ULTRON_TOKEN_ENCRYPTION_KEY=

# Render PostgreSQL connection string (keep this secret)
DATABASE_URL=
# Set PGSSLMODE=disable only for a trusted local database without TLS
